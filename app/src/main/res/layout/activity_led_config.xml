<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RadioButton android:id="@+id/radioOff" style="@style/ModeRadio" />
                <RadioButton android:id="@+id/radioOn" style="@style/ModeRadio" />
                <RadioButton android:id="@+id/radioAppActive" style="@style/ModeRadio" />
                <RadioButton android:id="@+id/radioCondition" style="@style/ModeRadio" />
                <RadioButton android:id="@+id/radioScript" style="@style/ModeRadio" />
                <RadioButton android:id="@+id/radioTime" style="@style/ModeRadio" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupApps"
            style="@style/SectionCard"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/select_apps_hint" />

                <TextView
                    android:id="@+id/txtSelectedAppsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnSelectApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_apps_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupCondition"
            style="@style/SectionCard"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/condition_hint" />

                <RadioGroup
                    android:id="@+id/radioGroupCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/radioConditionInternet" style="@style/ModeRadio" />
                    <RadioButton android:id="@+id/radioConditionStorage" style="@style/ModeRadio" />
                    <RadioButton android:id="@+id/radioConditionLauncher" style="@style/ModeRadio" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupScript"
            style="@style/SectionCard"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/custom_script_hint" />

                <EditText
                    android:id="@+id/editScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:hint="@string/custom_script_placeholder"
                    android:background="@drawable/edit_bg"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnCheckScriptNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/check_script_now" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="6dp"
                    android:text="@string/script_not_polled_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupTime"
            style="@style/SectionCard"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Our own TimeStepper component instead of the stock TimePicker/NumberPicker
                     widgets — see TimeStepper.kt for why. -->
                <TextView style="@style/SectionLabel" android:text="@string/time_from" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ua.tvremote.ledcontrol.TimeStepper
                        android:id="@+id/stepperFromHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text=":"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ua.tvremote.ledcontrol.TimeStepper
                        android:id="@+id/stepperFromMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/time_to" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ua.tvremote.ledcontrol.TimeStepper
                        android:id="@+id/stepperToHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text=":"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ua.tvremote.ledcontrol.TimeStepper
                        android:id="@+id/stepperToMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save" />

    </LinearLayout>
</ScrollView>
